# Runtime
NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1

# Comma-separated browser origins. Native Capacitor localhost origins are
# allowed automatically. Never use * in production.
CORS_ORIGINS=https://sales.example.com
JSON_BODY_LIMIT=256kb
FORM_BODY_LIMIT=256kb

# PostgreSQL
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=your-database
DB_USER=your-user
DB_PASSWORD=replace-me
DB_SSL=true
DB_TIMEZONE=Asia/Kolkata
DB_POOL_MAX=15
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_APPLICATION_NAME=rivergreen-backend

# Optional L2 cache. The API continues with its bounded memory cache if Redis
# is temporarily unavailable.
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
OWNER_REGISTRATION_SECRET=replace-with-a-private-bootstrap-secret

# Public QR receipt verification. Accounts keeps its own independent signing
# key; this service delegates Accounts tokens to the URL below.
RECEIPT_VERIFY_SECRET=replace-with-a-long-random-secret
RECEIPT_VERIFY_URL=https://defencegarden.com/verify-receipt
ACCOUNTS_API_URL=https://rgaccountbackend.onrender.com

# Sales AI assistant (server-only; never expose this key in Vite/Android)
OPENROUTER_API_KEY=
# Optional comma-separated override of the built-in free model cascade.
# Every model must support tool calling. Leave empty to use the defaults.
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
AI_CONTEXT_CACHE_TTL_MS=8000
AI_CHAT_RATE_LIMIT_PER_MINUTE=20
AI_CHAT_RATE_LIMIT_PER_DAY=100

# Sales AI request budget (ms) — keep under the app's 45s stream timeout.
AI_AGENT_TIMEOUT_MS=18000
AI_PRIORITY_CACHE_TTL_MS=2000
# Brand name the assistant uses when it refers to the product.
AI_BRAND_NAME=Defence Garden
